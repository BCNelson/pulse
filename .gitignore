.devenv/
.direnv/
.env
.env.*
!.env.example
!.env.dev.example

# Go
# `bin/` matches any directory named bin at any depth — preferred output
# dir for compiled binaries (e.g. `go build -o services/api/bin/seed`).
bin/
coverage.out
services/api/tmp/
# Stray binaries from `go build ./cmd/<name>` run inside services/api/.
# The output lands next to cmd/ with the same name as the package and
# shadows the source dir, so list known offenders explicitly.
/services/api/seed

# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
pubspec.lock
.android

# Android/iOS generated output
apps/mobile/android/
apps/mobile/ios/
apps/mobile/linux/
apps/mobile/macos/
apps/mobile/web/
apps/mobile/windows/

# Postgres/devenv state
.devenv-state/

# Claude Code per-machine state
.claude/

# Nix-generated, machine-local
local.properties

# devenv git-hooks installs a symlink wherever it's activated; only the root copy is meaningful
services/**/.pre-commit-config.yaml
