# /etc/pulse/pulse.env — operator-managed configuration. Make sure
# this file is mode 0640 and owned by root:pulse so the password
# isn't readable by other users.

# Required.
DATABASE_URL=postgres://pulse:CHANGE_ME@127.0.0.1:5432/pulse?sslmode=disable
GOOSE_MIGRATION_DIR=/usr/share/pulse/migrations

# API listen address.
API_ADDR=127.0.0.1:8080

# Mode: api | worker | both. Multi-replica deployments split.
PULSE_MODE=both

# Attachments (S3-compatible). Leave blank to disable uploads.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=pulse-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true

# Push (FCM service account JSON path).
PULSE_FCM_CREDENTIALS_FILE=
PULSE_FCM_PROJECT_ID=

# Push (APNs token-based auth).
PULSE_APNS_TEAM_ID=
PULSE_APNS_KEY_ID=
PULSE_APNS_KEY_FILE=
PULSE_APNS_TOPIC=
